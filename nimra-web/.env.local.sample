# Sample Environment Variables
# Copy this file to .env.local and fill in your actual values

# Your deployed Google Apps Script Web App URL
NEXT_PUBLIC_APPS_SCRIPT_URL=

# Google OAuth 2.0 Web Client ID. Add the production Vercel domain and any
# custom production domain to this client's Authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Use "local" for .storage/uploads or "blob" for Vercel Blob Storage.
STORAGE_PROVIDER=local

# Required when STORAGE_PROVIDER=blob. Vercel supplies this when a Blob store
# is connected to the project.
BLOB_READ_WRITE_TOKEN=
